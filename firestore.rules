rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    function keepsSameAdminFlag() {
      return request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false);
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && (
        (request.auth.uid == userId && request.resource.data.get('isAdmin', false) == false) ||
        isAdmin()
      );
      allow update: if signedIn() && ((request.auth.uid == userId && keepsSameAdminFlag()) || isAdmin());
      allow delete: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    match /tasks/{taskId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }
  }
}
