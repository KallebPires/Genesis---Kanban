MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=genesis
JWT_SECRET=change-this-to-a-long-random-string
PORT=3000

# Static key used by the local MCP server and the ChatGPT Custom GPT Action
# to call the API without a per-user login. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_API_KEY=

# GitHub Issues <-> Kanban sync (optional). Personal access token needs the
# "repo" scope (classic) or Issues read/write (fine-grained).
GITHUB_TOKEN=
GITHUB_SYNC_MINUTES=5
